# ─────────────── Database ───────────────
POSTGRES_USER=vlabel
POSTGRES_PASSWORD=vlabel
POSTGRES_DB=vlabel
DATABASE_URL=postgresql://vlabel:vlabel@localhost:5432/vlabel?schema=public

# ─────────────── API ───────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─────────────── Auth ───────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # 15 phút (giây)
JWT_REFRESH_TTL=1209600     # 14 ngày (giây)

# ─────────────── VNPC integration ───────────────
# Để trống VNPC_API_URL để dùng mock provider (clone chạy được ngay).
VNPC_API_URL=
VNPC_API_KEY=
VNPC_API_TIMEOUT=10000
VNPC_CACHE_TTL=300          # giây
VNPC_MAX_RETRY=2

# ─────────────── Storage ───────────────
STORAGE_DRIVER=local        # local | s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─────────────── Public ───────────────
PUBLIC_BASE_URL=http://localhost:5173

# ─────────────── Web (Vite) ───────────────
VITE_API_URL=http://localhost:4000/api
